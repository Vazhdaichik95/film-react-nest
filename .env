NODE_ENV=production
PORT=3000
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://film_user:film_password@postgres:5432/film_db
DATABASE_USERNAME=film_user
DATABASE_PASSWORD=film_password
DEBUG=*
LOGGER_TYPE=tskv

BACKEND_IMAGE=ghcr.io/vazhdaichik95/film-react-nest-backend:latest
FRONTEND_IMAGE=ghcr.io/vazhdaichik95/film-react-nest-frontend:latest
NGINX_IMAGE=ghcr.io/vazhdaichik95/film-react-nest-nginx:latest

NGINX_PORT=80
POSTGRES_PORT=5433
PGADMIN_PORT=8080

POSTGRES_DB=film_db
POSTGRES_USER=film_user
POSTGRES_PASSWORD=film_password

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin